<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#CC121212">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp" android:layout_marginLeft="64dp"
        android:layout_marginRight="64dp"
        android:orientation="vertical" android:background="@drawable/card_bg"
        android:padding="24dp">
        <TextView android:id="@+id/tvWarnTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Còn 5 phút nữa là hết giờ xem"
            android:textSize="32sp" android:textStyle="bold"
            android:textColor="@color/text_primary" android:gravity="center" />
        <TextView android:id="@+id/tvWarnSub"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="20sp"
            android:textColor="@color/text_muted" android:gravity="center"
            android:layout_marginTop="12dp" />
        <Button android:id="@+id/btnWarnOk" style="@style/TvButton"
            android:layout_width="match_parent" android:text="Đã hiểu"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</FrameLayout>
