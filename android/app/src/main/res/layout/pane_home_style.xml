<?xml version="1.0" encoding="utf-8"?>
<!-- v2: pane Kiểu icon &amp; thời tiết -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Kiểu icon &amp; thời tiết" style="@style/TvTitleV2" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Kiểu hiển thị icon app và thành phố dự báo thời tiết"
        style="@style/TvCaptionV2" android:layout_marginTop="4dp" />
    <LinearLayout android:id="@+id/homeStyleRows"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="8dp" />
</merge>
