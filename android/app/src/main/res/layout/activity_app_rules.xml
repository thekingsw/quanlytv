<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp"
    android:background="@color/bg_dark">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Giới hạn từng app" style="@style/TvTitle" />
    <TextView android:id="@+id/tvHint"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" style="@style/TvBody" android:textColor="@color/text_muted"
        android:layout_marginTop="8dp" />
    <ListView android:id="@+id/listApps"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="10dp"
        android:divider="#333333" android:dividerHeight="2dp" />
    <Button android:id="@+id/btnBack" style="@style/TvButton"
        android:layout_width="match_parent" android:text="Quay lại"
        android:layout_marginTop="10dp" />
</LinearLayout>
