<?xml version="1.0" encoding="utf-8"?>
<!-- v2: nội dung pane (tách từ activity_daily_limits.xml) — dùng trong SettingsFrame -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">


            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Giới hạn ngày theo ngày" style="@style/TvTitleV2" />
            <TextView android:id="@+id/tvHint"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" style="@style/TvCaptionV2"
                android:layout_marginTop="8dp" />

            <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginTop="14dp"
                android:clipChildren="false" android:clipToPadding="false">
                <LinearLayout android:id="@+id/listContainer"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false" android:clipToPadding="false" />
            </ScrollView>

            <Button android:id="@+id/btnBack" style="@style/TvButtonGhost"
                android:layout_width="match_parent" android:text="Quay lại"
                android:layout_marginTop="14dp" />
        
</merge>
