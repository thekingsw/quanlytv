<?xml version="1.0" encoding="utf-8"?>
<!-- v2.3 — Mã PIN web: rail+pane như các màn con khác. Hiện mã PIN web
     hiện tại cỡ lớn (màn này chỉ mở sau khi nhập đúng mã PIN khóa TV),
     đổi mã mới, hoặc đặt lại = mã PIN khóa TV. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:orientation="vertical"
    android:paddingTop="@dimen/margin_safe_vertical"
    android:paddingBottom="@dimen/margin_safe_vertical"
    android:paddingLeft="@dimen/margin_safe_horizontal"
    android:paddingRight="@dimen/margin_safe_horizontal">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal"
        android:clipChildren="false">

        <ScrollView android:id="@+id/railScroll"
            android:layout_width="@dimen/rail_width" android:layout_height="match_parent"
            android:scrollbars="vertical" android:fadeScrollbars="false"
            android:scrollbarStyle="outsideOverlay"
            android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:id="@+id/railContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginLeft="24dp"
            android:background="@drawable/card_bg" android:orientation="vertical"
            android:padding="28dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Mã PIN web" style="@style/TvTitle" />

            <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Mã PIN web hiện tại — dùng để mở trang điều khiển trên điện thoại. Mặc định bằng mã PIN khóa TV; đổi mã PIN khóa TV không làm đổi mã này."
                    style="@style/TvBody" android:textSize="18sp" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/tvWebPin"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="" android:textSize="48sp" android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Đổi mã PIN web" style="@style/TvSection" android:layout_marginTop="12dp" />
                <EditText android:id="@+id/etNewWebPin"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="8dp" android:hint="Mã PIN web mới (4–6 số)"
                    android:inputType="numberPassword"
                    android:textSize="18sp" android:textColor="@color/text_primary"
                    android:background="@drawable/card_bg" android:padding="12dp" />
                <Button android:id="@+id/btnChangeWebPin" style="@style/TvButtonPrimary"
                    android:layout_width="match_parent" android:text="Đổi mã PIN web"
                    android:layout_marginTop="8dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Quên mã PIN web?" style="@style/TvSection" android:layout_marginTop="12dp" />
                <Button android:id="@+id/btnResetWebPin" style="@style/TvButton"
                    android:layout_width="match_parent" android:text="Đặt lại = mã PIN khóa TV"
                    android:layout_marginTop="8dp" />

                <Button android:id="@+id/btnBack" style="@style/TvButton"
                    android:layout_width="match_parent" android:text="Quay lại"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/tvKeyHint"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="◀ ▶ ▲ ▼ Di chuyển · OK Chọn · Back Quay lại"
        android:textSize="16sp" android:textColor="@color/text_muted" />
</LinearLayout>
