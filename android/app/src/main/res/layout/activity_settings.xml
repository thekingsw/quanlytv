<?xml version="1.0" encoding="utf-8"?>
<!-- redesign 2.2 giai đoạn 3 — khung rail+pane theo design-pack/design/tv-settings.html.
     Khung 960x540, lề an toàn 48dp ngang / 27dp dọc, rail 250dp + pane thẻ phải.
     v2.4: rail bọc ScrollView (thêm mục sau này không mất mục dưới);
     pane Tổng quan thành dashboard trực quan (3 thẻ số + thanh tiến độ +
     biểu đồ 7 ngày + khóa đêm / giờ thời sự), nội dung cuộn, nút Quay lại ghim đáy. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:orientation="vertical"
    android:paddingTop="@dimen/margin_safe_vertical"
    android:paddingBottom="@dimen/margin_safe_vertical"
    android:paddingLeft="@dimen/margin_safe_horizontal"
    android:paddingRight="@dimen/margin_safe_horizontal">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal"
        android:clipChildren="false">

        <!-- Rail trái: SettingsRail.build() dựng tiêu đề + mục vào đây;
             ScrollView để thêm mục mới không mất mục dưới. -->
        <ScrollView android:id="@+id/railScroll"
            android:layout_width="@dimen/rail_width" android:layout_height="match_parent"
            android:scrollbars="vertical" android:fadeScrollbars="false"
            android:scrollbarStyle="outsideOverlay"
            android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:id="@+id/railContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Pane phải: dashboard Tổng quan -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginLeft="24dp"
            android:background="@drawable/card_bg" android:orientation="vertical"
            android:padding="20dp">

            <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng quan" style="@style/TvTitle" />
                    <TextView android:id="@+id/tvStatus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ĐANG MỞ" android:textSize="16sp" android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/on_open"
                        android:background="@drawable/pill_open"
                        android:paddingLeft="18dp" android:paddingRight="18dp"
                        android:paddingTop="6dp" android:paddingBottom="6dp" />
                </LinearLayout>

                <!-- 3 thẻ số liệu -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:background="@drawable/row_bg" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Đã xem" android:textSize="16sp" android:textColor="@color/text_muted" />
                        <TextView android:id="@+id/tvStatUsed"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="0 phút"
                            android:textSize="28sp" android:textStyle="bold" android:textColor="@color/text"
                            android:maxLines="1" android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="28sp"
                            android:autoSizeStepGranularity="1sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:background="@drawable/row_bg" android:padding="12dp"
                        android:layout_marginLeft="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Còn lại" android:textSize="16sp" android:textColor="@color/text_muted" />
                        <TextView android:id="@+id/tvStatRemaining"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="—"
                            android:textSize="28sp" android:textStyle="bold" android:textColor="@color/text"
                            android:maxLines="1" android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="28sp"
                            android:autoSizeStepGranularity="1sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:background="@drawable/row_bg" android:padding="12dp"
                        android:layout_marginLeft="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Phút thưởng" android:textSize="16sp" android:textColor="@color/text_muted" />
                        <TextView android:id="@+id/tvStatBonus"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="0 phút"
                            android:textSize="28sp" android:textStyle="bold" android:textColor="@color/text"
                            android:maxLines="1" android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="28sp"
                            android:autoSizeStepGranularity="1sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Thanh tiến độ hôm nay -->
                <ProgressBar android:id="@+id/progressUsed"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="14dp"
                    android:layout_marginTop="16dp"
                    android:minHeight="14dp" android:maxHeight="14dp"
                    android:max="100" android:progress="0"
                    android:progressDrawable="@drawable/progress_home" />
                <TextView android:id="@+id/tvUsed"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text=""
                    android:textSize="16sp" android:textColor="@color/text_muted" />

                <!-- Biểu đồ 7 ngày -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="7 ngày qua · phút"
                    android:textSize="18sp" android:textColor="@color/text_muted" />
                <LinearLayout android:id="@+id/chartContainer"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/tvChartEmpty"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:visibility="gone"
                    android:text="Chưa đủ dữ liệu 7 ngày qua"
                    android:textSize="18sp" android:textColor="@color/text_muted" />

                <!-- Khóa đêm / giờ thời sự -->
                <TextView android:id="@+id/tvNightLock"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text=""
                    android:textSize="18sp" android:textColor="@color/text" />
                <TextView android:id="@+id/tvNewsSlot"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text=""
                    android:textSize="18sp" android:textColor="@color/text" />
            </LinearLayout>
            </ScrollView>

            <Button android:id="@+id/btnBack" style="@style/TvButtonGhost"
                android:layout_width="match_parent" android:text="Quay lại"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/tvKeyHint"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="◀ ▶ ▲ ▼ Di chuyển · OK Chọn · Back Quay lại"
        android:textSize="16sp" android:textColor="@color/text_muted" />
</LinearLayout>
