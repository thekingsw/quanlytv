<?xml version="1.0" encoding="utf-8"?>
<!-- ListRow dùng lại (giai đoạn 1 chỉ tạo file, giai đoạn 3 mới dùng):
     cao 72dp, nền card2 radius 16dp, tiêu đề 22sp + chi tiết 22sp muted + "›". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_row_height"
    android:orientation="horizontal"
    android:background="@drawable/row_selector"
    android:stateListAnimator="@animator/focus_scale"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:gravity="center_vertical"
    android:focusable="true">

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text" />

    <TextView
        android:id="@+id/rowDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:textSize="22sp"
        android:textColor="@color/muted" />

    <TextView
        android:id="@+id/rowChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="22sp"
        android:textColor="@color/muted" />

</LinearLayout>
