<?xml version="1.0" encoding="utf-8"?>
<!-- ListRow v2: cao 52dp, nền card2 bo 12dp, tiêu đề 16sp + chi tiết 15sp
     muted + "›". Tên bên trái, GIÁ TRỊ HIỆN TẠI bên phải. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_row_height"
    android:orientation="horizontal"
    android:background="@drawable/row_selector"
    android:stateListAnimator="@animator/focus_scale_v2"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:gravity="center_vertical"
    android:focusable="true">

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text" />

    <TextView
        android:id="@+id/rowDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:textSize="15sp"
        android:textColor="@color/muted" />

    <TextView
        android:id="@+id/rowChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="16sp"
        android:textColor="@color/muted" />

</LinearLayout>
