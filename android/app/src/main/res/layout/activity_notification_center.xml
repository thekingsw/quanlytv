<?xml version="1.0" encoding="utf-8"?>
<!-- v4.0: trung tâm thông báo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0F1626"
    android:orientation="vertical"
    android:padding="40dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tvNotifTitle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thông báo" android:textSize="30sp" android:textStyle="bold"
            android:textColor="@color/text_primary" />
        <Button
            android:id="@+id/btnNotifBack"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Đóng" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvNotifEmpty"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Chưa có thông báo nào."
        android:textSize="18sp" android:textColor="@color/text_muted"
        android:visibility="gone" />
    <ListView
        android:id="@+id/notifList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:divider="#223"
        android:dividerHeight="1dp" />
</LinearLayout>
