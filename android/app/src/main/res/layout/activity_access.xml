<?xml version="1.0" encoding="utf-8"?>
<!-- redesign 2.2 giai đoạn 3 — rail+pane; nội dung pane cuộn trong ScrollView.
     Giữ nguyên mọi id (tvAccess, tvAntiDisable, tvIconState, btnAntiDisableToggle,
     btnIconToggle, btnAccessSettings, btnOpenMain, btnBack).
     Màu #FFEB3B cũ của tvAccess đổi sang token accent cho đúng theme 2.2. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:orientation="vertical"
    android:paddingTop="@dimen/margin_safe_vertical"
    android:paddingBottom="@dimen/margin_safe_vertical"
    android:paddingLeft="@dimen/margin_safe_horizontal"
    android:paddingRight="@dimen/margin_safe_horizontal">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal"
        android:clipChildren="false">

        <ScrollView android:id="@+id/railScroll"
            android:layout_width="@dimen/rail_width" android:layout_height="match_parent"
            android:scrollbars="vertical" android:fadeScrollbars="false"
            android:scrollbarStyle="outsideOverlay"
            android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:id="@+id/railContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginLeft="24dp"
            android:background="@drawable/card_bg" android:orientation="vertical"
            android:padding="28dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Trợ năng &amp; hiển thị" style="@style/TvTitle" />

            <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Trợ năng" style="@style/TvSection" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/tvAccess"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="" style="@style/TvBody" android:textSize="18sp"
                    android:textColor="@color/accent" android:layout_marginTop="8dp" />
                <Button android:id="@+id/btnAccessSettings" style="@style/TvButton"
                    android:layout_width="match_parent" android:text="Mở cài đặt Trợ năng của TV"
                    android:layout_marginTop="8dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Chống tắt" style="@style/TvSection" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/tvAntiDisable"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="" style="@style/TvBody" android:textSize="18sp"
                    android:layout_marginTop="8dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Chống tắt: ai tắt Trợ năng trong Cài đặt TV thì app tự bật lại trong 1 giây. Cần quyền ghi cài đặt hệ thống (Cài TV cấp sau khi cài). Tắt chống tắt rồi mới tắt được Trợ năng."
                    style="@style/TvBody" android:textColor="@color/text_muted"
                    android:layout_marginTop="8dp" />
                <Button android:id="@+id/btnAntiDisableToggle" style="@style/TvButton"
                    android:layout_width="match_parent" android:text="Tắt chống tắt"
                    android:layout_marginTop="8dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Hiển thị icon" style="@style/TvSection" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/tvIconState"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="" style="@style/TvBody" android:textSize="18sp"
                    android:layout_marginTop="8dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Icon ẩn thì trẻ khó thấy app. Bố vẫn mở được qua Trợ năng, màn hình khóa, hoặc ADB."
                    style="@style/TvBody" android:textColor="@color/text_muted"
                    android:layout_marginTop="8dp" />
                <Button android:id="@+id/btnIconToggle" style="@style/TvButton"
                    android:layout_width="match_parent" android:text="Hiện icon"
                    android:layout_marginTop="8dp" />
                <Button android:id="@+id/btnOpenMain" style="@style/TvButton"
                    android:layout_width="match_parent" android:text="Mở màn hình chính"
                    android:layout_marginTop="8dp" />

                <Button android:id="@+id/btnBack" style="@style/TvButton"
                    android:layout_width="match_parent" android:text="Quay lại"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/tvKeyHint"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="◀ ▶ ▲ ▼ Di chuyển · OK Chọn · Back Quay lại"
        android:textSize="16sp" android:textColor="@color/text_muted" />
</LinearLayout>
