<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="32dp"
    android:background="#B71C1C" android:gravity="center_horizontal">
    <TextView android:id="@+id/tvReason" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Đã khóa" android:textSize="44sp" android:textColor="#FFFFFF" android:textStyle="bold" />
    <TextView android:id="@+id/tvClock" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Nhập mã PIN để mở khóa" android:textSize="28sp" android:textColor="#FFFFFF" android:layout_marginTop="12dp" />
    <TextView android:id="@+id/tvPin" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="____" android:textSize="48sp" android:textColor="#FFFFFF" android:layout_marginTop="16dp" />
    <LinearLayout android:id="@+id/pinView" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="16dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/key1" android:layout_width="110dp" android:layout_height="72dp" android:text="1" android:textSize="30sp" />
            <Button android:id="@+id/key2" android:layout_width="110dp" android:layout_height="72dp" android:text="2" android:textSize="30sp" />
            <Button android:id="@+id/key3" android:layout_width="110dp" android:layout_height="72dp" android:text="3" android:textSize="30sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/key4" android:layout_width="110dp" android:layout_height="72dp" android:text="4" android:textSize="30sp" />
            <Button android:id="@+id/key5" android:layout_width="110dp" android:layout_height="72dp" android:text="5" android:textSize="30sp" />
            <Button android:id="@+id/key6" android:layout_width="110dp" android:layout_height="72dp" android:text="6" android:textSize="30sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/key7" android:layout_width="110dp" android:layout_height="72dp" android:text="7" android:textSize="30sp" />
            <Button android:id="@+id/key8" android:layout_width="110dp" android:layout_height="72dp" android:text="8" android:textSize="30sp" />
            <Button android:id="@+id/key9" android:layout_width="110dp" android:layout_height="72dp" android:text="9" android:textSize="30sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/keyDel" android:layout_width="110dp" android:layout_height="72dp" android:text="Xóa" android:textSize="26sp" />
            <Button android:id="@+id/key0" android:layout_width="110dp" android:layout_height="72dp" android:text="0" android:textSize="30sp" />
            <Button android:id="@+id/keyOk" android:layout_width="110dp" android:layout_height="72dp" android:text="OK" android:textSize="26sp" />
        </LinearLayout>
        <Button android:id="@+id/btnCancel" android:layout_width="match_parent" android:layout_height="64dp"
            android:text="Hủy" android:textSize="24sp" android:layout_marginTop="12dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/optionsView" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone" android:layout_marginTop="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PIN đúng — chọn thao tác:" android:textSize="28sp" android:textColor="#FFFFFF" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/optAdd5" android:layout_width="110dp" android:layout_height="72dp" android:text="+5'" android:textSize="26sp" />
            <Button android:id="@+id/optAdd10" android:layout_width="110dp" android:layout_height="72dp" android:text="+10'" android:textSize="26sp" />
            <Button android:id="@+id/optAdd15" android:layout_width="110dp" android:layout_height="72dp" android:text="+15'" android:textSize="26sp" />
            <Button android:id="@+id/optAdd20" android:layout_width="110dp" android:layout_height="72dp" android:text="+20'" android:textSize="26sp" />
            <Button android:id="@+id/optAdd30" android:layout_width="110dp" android:layout_height="72dp" android:text="+30'" android:textSize="26sp" />
        </LinearLayout>
        <Button android:id="@+id/optUnlockEnd" android:layout_width="match_parent" android:layout_height="72dp"
            android:text="Mở đến hết khung khóa" android:textSize="26sp" android:layout_marginTop="12dp" />
        <Button android:id="@+id/optCancel" android:layout_width="match_parent" android:layout_height="64dp"
            android:text="Hủy" android:textSize="24sp" android:layout_marginTop="12dp" />
    </LinearLayout>
</LinearLayout>
