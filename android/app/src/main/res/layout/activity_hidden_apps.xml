<?xml version="1.0" encoding="utf-8"?>
<!-- v3.0: danh sách app đã ẩn — bấm để ẩn/hiện lại. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ứng dụng đã ẩn"
        android:textColor="@color/text"
        android:textSize="36sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Bấm vào một app để ẩn / hiện lại"
        android:textColor="@color/muted"
        android:textSize="16sp" />

    <ListView
        android:id="@+id/hiddenList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:divider="@color/card2"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_ghost_selector"
        android:focusable="true"
        android:minWidth="160dp"
        android:text="Quay lại"
        android:textColor="@color/text"
        android:textSize="18sp" />
</LinearLayout>
