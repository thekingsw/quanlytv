<?xml version="1.0" encoding="utf-8"?>
<!-- v2: pane Ảnh nền (tách từ HomeSettingsActivity) -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Ảnh nền" style="@style/TvTitleV2" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Slideshow ảnh nền màn hình chính"
        style="@style/TvCaptionV2" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/tvHomeBgState"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        style="@style/TvBodyV2" android:layout_marginTop="12dp" />
    <LinearLayout android:id="@+id/homeBgRows"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="8dp" />
</merge>
