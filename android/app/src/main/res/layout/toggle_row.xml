<?xml version="1.0" encoding="utf-8"?>
<!-- ToggleRow v2: cao 52dp như ListRow, tên 16sp bên trái, Switch 44x24dp
     bên phải. Dùng bởi ToggleRows.kt -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_row_height"
    android:orientation="horizontal"
    android:background="@drawable/row_selector"
    android:stateListAnimator="@animator/focus_scale_v2"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:gravity="center_vertical"
    android:focusable="true">

    <TextView
        android:id="@+id/toggleTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text" />

    <TextView
        android:id="@+id/toggleDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:textSize="13sp"
        android:textColor="@color/muted" />

    <Switch
        android:id="@+id/toggleSwitch"
        android:layout_width="44dp"
        android:layout_height="24dp"
        android:focusable="false"
        android:clickable="false" />

</LinearLayout>
