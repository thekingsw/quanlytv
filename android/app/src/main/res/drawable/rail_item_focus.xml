<?xml version="1.0" encoding="utf-8"?>
<!-- Focus rail item chưa chọn: vòng sáng hổ phách 45% + nền card2 + viền trắng 4dp, radius 12dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_glow" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card2" />
            <stroke android:width="4dp" android:color="@color/focus_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
