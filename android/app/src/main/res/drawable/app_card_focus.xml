<?xml version="1.0" encoding="utf-8"?>
<!-- v3.0: focus cho ô app màn hình chính — vòng sáng hổ phách + viền trắng 4dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_glow" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke android:width="4dp" android:color="@color/focus_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
