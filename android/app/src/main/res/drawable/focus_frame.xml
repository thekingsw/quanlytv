<?xml version="1.0" encoding="utf-8"?>
<!-- Khung chọn kiểu "thấu kính trong suốt" (kiểu CleanTV): lớp kính mờ
     trượt theo hướng bấm phím, gradient sáng trên tạo hiệu ứng thủy tinh. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Thân kính: trắng mờ nhẹ -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Bóng kính trên: sáng nhẹ tạo hiệu ứng thấu kính -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#59FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#08FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Viền sáng mảnh -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="#B3FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
