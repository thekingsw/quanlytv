<?xml version="1.0" encoding="utf-8"?>
<!-- v2: Focus ListRow — vòng sáng hổ phách 45% + nền card2 + viền trắng 3dp, bo 12dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_glow" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card2" />
            <stroke android:width="3dp" android:color="@color/focus_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
