<?xml version="1.0" encoding="utf-8"?>
<!-- Focus 2.2: vòng sáng hổ phách 45% + viền trắng 4dp, radius 14dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_glow" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/locked" />
            <stroke android:width="4dp" android:color="@color/focus_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
