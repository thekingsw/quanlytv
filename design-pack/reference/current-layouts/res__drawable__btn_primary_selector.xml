<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="0">
      <solid android:color="@7F01000B"/>
      <corners android:radius="12.000000dip"/>
    </shape>
  </item>
  <item android:state_focused="true">
    <shape android:shape="0">
      <solid android:color="@7F01000C"/>
      <stroke android:width="3.000000dip" android:color="@7F01000F"/>
      <corners android:radius="12.000000dip"/>
    </shape>
  </item>
  <item>
    <shape android:shape="0">
      <solid android:color="@7F01000A"/>
      <stroke android:width="2.000000dip" android:color="@7F01000B"/>
      <corners android:radius="12.000000dip"/>
    </shape>
  </item>
</selector>
